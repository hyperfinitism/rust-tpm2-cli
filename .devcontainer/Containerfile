FROM rust:1.100.0-trixie@sha256:223cc32ddca8f3ee90c436dbc94b6b5f052ea7f9653c5201e9612f08ad7d21b8

ARG TPM2_TSS_VERSION=bcc9cdaf490dadb368db4250fb7912cedfd14346   # version 4.2.2

RUN rustup component add rustfmt clippy \
    && cargo install --locked cargo-rdme \
    && cargo install --locked cargo-llvm-cov

RUN apt-get update && apt-get install -y --no-install-recommends \
        autoconf \
        autoconf-archive \
        automake \
        build-essential \
        ca-certificates \
        curl \
        doxygen \
        git \
        gnupg \
        libcmocka-dev \
        libcmocka0 \
        libcurl4-openssl-dev \
        libftdi-dev \
        libini-config-dev \
        libjson-c-dev \
        libltdl-dev \
        libssl-dev \
        libtool \
        libusb-1.0-0-dev \
        man \
        pkg-config \
        swtpm \
        swtpm-tools \
        uthash-dev \
        uuid-dev \
    && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/tpm2-software/tpm2-tss /tmp/tpm2-tss \
    && cd /tmp/tpm2-tss \
    && git checkout "${TPM2_TSS_VERSION}" \
    && ./bootstrap \
    && ./configure --prefix=/usr --disable-fapi --disable-weakcrypto --disable-integration \
    && make -j"$(nproc)" \
    && make install \
    && ldconfig \
    && rm -rf /tmp/tpm2-tss

WORKDIR /workspaces/rust-tpm2-cli
